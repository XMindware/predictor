{
  "info": {
    "_postman_id": "2cb54c6d-efed-4cc3-ae8e-9d3470b53353",
    "name": "Predictor API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for Predictor API v1. Includes health, token management, risk assessment, and route risk. Risk endpoints are Sanctum-protected and limited to monitored routes within the next 72 hours."
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Public health endpoint."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var data = pm.response.json();",
                  "  pm.collectionVariables.set('apiToken', data.token);",
                  "  if (data.user && data.user.email) {",
                  "    pm.collectionVariables.set('email', data.user.email);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"token_name\": \"{{tokenName}}\",\n  \"abilities\": [\"*\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tokens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tokens"
              ]
            },
            "description": "Exchange valid user credentials for a Sanctum bearer token. Saves the returned token into `apiToken`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Protected",
      "item": [
        {
          "name": "GET /api/user",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user"
              ]
            },
            "description": "Returns the authenticated user for the supplied bearer token."
          },
          "response": []
        },
        {
          "name": "GET /api/tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var data = pm.response.json();",
                  "  if (data.data && data.data.length > 0) {",
                  "    pm.collectionVariables.set('tokenId', data.data[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tokens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tokens"
              ]
            },
            "description": "Lists tokens owned by the authenticated user. Saves the first token id into `tokenId`."
          },
          "response": []
        },
        {
          "name": "DELETE /api/tokens/:tokenId",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tokens/{{tokenId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tokens",
                "{{tokenId}}"
              ]
            },
            "description": "Revokes a token owned by the authenticated user."
          },
          "response": []
        },
        {
          "name": "POST /api/risk-assessment",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin_airport\": \"{{originAirport}}\",\n  \"destination_airport\": \"{{destinationAirport}}\",\n  \"travel_date\": \"{{travelDate}}\",\n  \"airline_code\": \"{{airlineCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/risk-assessment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "risk-assessment"
              ]
            },
            "description": "Decision-oriented risk evaluation for a monitored route. Returns score, risk level, confidence, freshness, drivers, probable no-show uplift, and recommended action. Travel date must be within the next 72 hours."
          },
          "response": []
        },
        {
          "name": "GET /api/routes/risk",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/routes/risk?destination={{destinationCode}}&date={{travelDate}}&limit={{routeLimit}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "routes",
                "risk"
              ],
              "query": [
                {
                  "key": "destination",
                  "value": "{{destinationCode}}"
                },
                {
                  "key": "date",
                  "value": "{{travelDate}}"
                },
                {
                  "key": "limit",
                  "value": "{{routeLimit}}"
                }
              ]
            },
            "description": "Ranks monitored routes into a destination by risk. Returns route-level score, confidence, freshness, drivers, probable no-show uplift, and recommended action. Travel date must be within the next 72 hours."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "email",
      "value": "superadmin@predictor.local",
      "type": "string"
    },
    {
      "key": "password",
      "value": "password",
      "type": "string"
    },
    {
      "key": "tokenName",
      "value": "postman-client",
      "type": "string"
    },
    {
      "key": "apiToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenId",
      "value": "",
      "type": "string"
    },
    {
      "key": "originAirport",
      "value": "JFK",
      "type": "string"
    },
    {
      "key": "destinationAirport",
      "value": "CUN",
      "type": "string"
    },
    {
      "key": "destinationCode",
      "value": "CUN",
      "type": "string"
    },
    {
      "key": "travelDate",
      "value": "2026-03-22",
      "type": "string"
    },
    {
      "key": "airlineCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "routeLimit",
      "value": "10",
      "type": "string"
    }
  ]
}
